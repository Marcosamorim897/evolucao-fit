# Postgres do Neon. Use a connection string do endpoint "-pooler".
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/evolucaofit?sslmode=require

# Segredo para assinar os tokens JWT (gere com: python3 -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=troque-isto-por-um-segredo-aleatorio

# Opcional: deixe em branco para permitir cadastro livre, ou defina um codigo
# que os amigos precisam digitar para criar conta.
CODIGO_CONVITE=
